/system/database-29","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#manual-backups","content":"Verification: Regularly verify the size and contents of your backup files."},"1058":{"id":"/en/docs/Hydro/system/database-30","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#manual-backups","content":"Off-Site Storage: Always store backups on a different machine or cloud storage to mitigate hardware failure risks."},"1059":{"id":"/en/docs/Hydro/system/database-31","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#manual-restore","content":"Use mongorestore to import the database data."},"1060":{"id":"/en/docs/Hydro/system/database-32","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#manual-restore","content":"Restore the contents of /data/file to the corresponding path on your new server."},"1061":{"id":"/en/docs/Hydro/system/frontend-modify","page_id":"/en/docs/Hydro/system/frontend-modify","type":"page","content":"Frontend Modification","breadcrumbs":["Docs","Hydro","System Documentation"],"tags":[],"url":"/en/docs/Hydro/system/frontend-modify"},"1062":{"id":"/en/docs/Hydro/system/frontend-modify-0","page_id":"/en/docs/Hydro/system/frontend-modify","type":"heading","tags":[],"url":"/en/docs/Hydro/system/frontend-modify#modify-page-translations-or-add-a-new-language","content":"Modify page translations or add a new language:"},"1063":{"id":"/en/docs/Hydro/system/frontend-modify-1","page_id":"/en/docs/Hydro/system/frontend-modify","type":"heading","tags":[],"url":"/en/docs/Hydro/system/frontend-modify#modify-page-templates","content":"Modify page templates:"},"1064":{"id":"/en/docs/Hydro/system/frontend-modify-2","page_id":"/en/docs/Hydro/system/frontend-modify","tags":[],"type":"text","url":"/en/docs/Hydro/system/frontend-modify","content":"This guide teaches you how to modify frontend files."},"1065":{"id":"/en/docs/Hydro/system/frontend-modify-3","page_id":"/en/docs/Hydro/system/frontend-modify","tags":[],"type":"text","url":"/en/docs/Hydro/system/frontend-modify","content":"If you are using developer mode, directly modify files under packages/ui-default/templates."},"1066":{"id":"/en/docs/Hydro/system/frontend-modify-4","page_id":"/en/docs/Hydro/system/frontend-modify","tags":[],"type":"text","url":"/en/docs/Hydro/system/frontend-modify","content":"If you deployed using the installation script:"},"1067":{"id":"/en/docs/Hydro/system/frontend-modify-5","page_id":"/en/docs/Hydro/system/frontend-modify","tags":[],"type":"text","url":"/en/docs/Hydro/system/frontend-modify","content":"First run hydrooj addon create to create a local addon (if you have not done this before)."},"1068":{"id":"/en/docs/Hydro/system/frontend-modify-6","page_id":"/en/docs/Hydro/system/frontend-modify","tags":[],"type":"text","url":"/en/docs/Hydro/system/frontend-modify#modify-page-translations-or-add-a-new-language","content":"Modify translations: search the translation you want to change in zh.yaml, then add only that line, not the whole file after editing into ~/addon/locales/zh.yaml."},"1069":{"id":"/en/docs/Hydro/system/frontend-modify-7","page_id":"/en/docs/Hydro/system/frontend-modify","tags":[],"type":"text","url":"/en/docs/Hydro/system/frontend-modify#modify-page-translations-or-add-a-new-language","content":"Add a language: create a new file using zh.yaml as reference format. Community contributions to multilingual translations are welcome."},"1070":{"id":"/en/docs/Hydro/system/frontend-modify-8","page_id":"/en/docs/Hydro/system/frontend-modify","tags":[],"type":"text","url":"/en/docs/Hydro/system/frontend-modify#modify-page-templates","content":"Usually, add view-source: before the URL you visit (for example, view-source:https://hydro.ac) to view source code. In line 2, <html data-page=\"xxx\"> contains data-page, which is the