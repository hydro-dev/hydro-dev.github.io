ro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#backup-and-restore","content":"To ensure data integrity, we recommend scheduling regular backups."},"1034":{"id":"/en/docs/Hydro/system/database-16","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#automated-backups","content":"If you installed Hydro using the automated script, use the following commands:"},"1035":{"id":"/en/docs/Hydro/system/database-17","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#automated-backups","content":"Backup: hydrooj backup"},"1036":{"id":"/en/docs/Hydro/system/database-18","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#automated-backups","content":"This generates a .zip archive in your current directory containing both the database and files."},"1037":{"id":"/en/docs/Hydro/system/database-19","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#automated-backups","content":"Parameters: --dbOnly (Database only), --withAddons, --withLogs."},"1038":{"id":"/en/docs/Hydro/system/database-20","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#automated-backups","content":"Restore: hydrooj restore <path_to_backup_file>"},"1039":{"id":"/en/docs/Hydro/system/database-21","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#incremental-backups-hydro-500","content":"Hydro supports incremental backups via Restic."},"1040":{"id":"/en/docs/Hydro/system/database-22","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#incremental-backups-hydro-500","content":"Initialize a repository: restic init"},"1041":{"id":"/en/docs/Hydro/system/database-23","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#incremental-backups-hydro-500","content":"Run backup: hydrooj backup -r <repo_address> -p <repo_password>"},"1042":{"id":"/en/docs/Hydro/system/database-24","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#manual-backups","content":"If you prefer standard tools:"},"1043":{"id":"/en/docs/Hydro/system/database-25","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#manual-backups","content":"Use mongodump for the database."},"1044":{"id":"/en/docs/Hydro/system/database-26","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#manual-backups","content":"Back up the /data/file directory for test data and attachments."},"1045":{"id":"/en/docs/Hydro/system/database-27","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#manual-backups","content":"Best Practices:"},"1046":{"id":"/en/docs/Hydro/system/database-28","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#manual-backups","content":"Never copy the database directory while MongoDB is running."},"1047":{"id":"/en/docs/Hydro/system/database-29","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#manual-backups","content":"Verification: Regularly verify the size and contents of your backup files."},"1048":{"id":"/en/docs/Hydro/system/database-30","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#manual-backups","content":"Off-Site Storage: Always store backups on a different machine or cloud storage to mitigate hardware failure risks."},"1049":{"id":"/en/docs/Hydro/system/database-31","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#manual-restore","content":"Use mongorestore to import the database data."},"1050":{"id":"/en/docs/Hydro/system/database-32","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#manual-restore","content":"Restore the contents of /data/file to the corresponding path on your new server."},"1051":{"id":"/en/docs/Hydro/system/frontend-modify","page_id":"/en/docs/Hydro/system/frontend-modify","type":"page","content":"Frontend Modification","breadcrumbs":["Docs","Hydro","System Documentation"],"tags":[],"url":"/en/docs/Hydro/system/frontend-modify"},"1052":{"id":"/en/docs/Hydro/system/frontend-modify-0","page_id":"/en/docs/Hydro/system/frontend-modify","type":"heading","tags":[],"url":"/en/docs/Hydro/system/frontend-modify#modify-page-translations-or-add-a-new-language","content":"Modify page translations or add a new language:"},"1053":{"id":"/en/docs/Hydro/system/frontend-modify-1","page_id":"/en/docs/Hydro/system/frontend-modify","type":"heading","tags":[],"url":"/en/docs/Hydro/system/frontend-modify#modify-page-templates","content":"Modify page templates:"},"1054":{"id":"/en/docs/Hydro/system/frontend-modify-2","page_id":"/en/docs/Hydro/system/frontend-modify","tags":[],"type":"text","url":"/en/docs/Hydro/system/frontend-modify","content":"This guide teaches you how to modify frontend files."},"1055":{"id":"/en/docs/Hydro/system/frontend-modify-3","page_id":"/en/docs/Hydro/system/frontend-modify","tags":[],"type":"text","url":"/en/docs/Hydro/system/frontend-modify","content":"If you are using developer mode, directly modify files under packages/ui-default/templates."},"1056":{"id":"/en/docs/Hydro/system/frontend-modify-4","page_id":"/en/docs/Hydro/system/frontend-modify","tags":[],"type":"text","url":"/en/docs/Hydro/system/frontend-modify","content":"If you deployed using the installation script:"},"1057":{"id":"/en/docs/Hydro/system/frontend-modify-5","page_id":"/en/docs/Hydro/system/frontend-modify","tags":[],"type":"text","url":"/en/docs/Hydro/system/frontend-modify","content":"First run hydrooj addon create to create a local addon (if you have not done this before)."},"1058":{"id":"/en/docs/Hydro/system/frontend-modify-6","page_id":"/en/docs/Hydro/system/frontend-modify","tags":[],"type":"text","url":"/en/docs/Hydro/system/frontend-modify#modify-page-translations-or-add-a-new-language","content":"Modify translations: search the translation you want to change in zh.yaml, then add only that line, not the whole file after editing into ~/addon/locales/zh.yaml."},"1059":{"id":"/en/docs/Hydro/system/frontend-modify-7","page_id":"/en/docs/Hydro/system/frontend-modify","tags":[],"type":"text","url":"/en/docs/Hydro/system/frontend-modify#modify-page-translations-or-add-a-new-language","content":"Add a language: create a new file using zh.yaml as reference format. Community contributions to multilingual translations are welcome."},"1060":{"id":"/en/docs/Hydro/system/frontend-modify-8","page_id":"/en/docs/Hydro/system/frontend-modify","tags":[],"type":"text","url":"/en/docs/Hydro/system/frontend-modify#modify-page-templates","content":"Usually, add view-source: before the URL you visit (for example, view-source:https://hydro.ac) to view source code. In line 2, <html data-page=\"xxx\"> contains data-page, which is the page name (except homepage, which is main.html).\nFind the corresponding file in default templates, copy the entire file content to ~/addon/templates/, then modify it."},"1061":{"id":"/en/docs/Hydro/system/frontend-modify-9","page_id":"/en/docs/Hydro/system/frontend-modify","tags":[],"type":"text","url":"/en/docs/Hydro/system/frontend-modify#modify-page-templates","content":"type: warn"},"1062":{"id":"/en/docs/Hydro/system/frontend-modify-10","page_id":"/en/docs/Hydro/system/frontend-modify","tags":[],"type":"text","url":"/en/docs/Hydro/system/frontend-modify#modify-page-templates","content":"Template modification may cause feature issues after system upgrades. For better compatibility, we recommend using addon frontend features to dynamically inject/modify elements, instead of replacing entire templates."},"1063":{"id":"/en/docs/Hydro/system/frontend-modify-11","page_id":"/en/docs/Hydro/system/frontend-modify","tags":[],"type":"text","url":"/en/docs/Hydro/system/frontend-modify#modify-page-templates","content":"For more details, see Plugin Development."},"1064":{"id":"/en/docs/Hydro/system/frontend-modify-12","page_id":"/en/docs/Hydro/system/frontend-modify","tags":[],"type":"text","url":"/en/docs/Hydro/system/frontend-modify#modify-page-templates","content":"In particular, the default template for creating problems is at partials/problem_default.md, and for creating training plans at partials/training_default.json; modify them the same way."},"1065":{"id":"/en/docs/Hydro/system/frontend-modify-13","page_id":"/en/docs/Hydro/system/frontend-modify","tags":[],"type":"text","url":"/en/docs/Hydro/system/frontend-modify#modify-page-templates","content":"All changes above take effect after restarting Hydro."},"1066":{"id":"/en/docs/Hydro/system/import-user","page_id":"/en/docs/Hydro/system/import-user","type":"page","content":"Import Users","breadcrumbs":["Docs","Hydro","System Documentation"],"tags":[],"url":"/en/docs/Hydro/system/import-user"},"1067":{"id":"/en/docs/Hydro/system/import-user-0","page_id":"/en/docs/Hydro/system/import-user","tags":[],"type":"text","url":"/en/docs/Hydro/system/import-user","content":"Currently supports importing user data in CSV format (separated by ,) or Excel format (TAB-separated). Data can be created with a text editor or with tools like Excel."},"1068":{"id":"/en/docs/Hydro/system/import-user-1","page_id":"/en/docs/Hydro/system/import-user","tags":[],"type":"text","url":"/en/docs/Hydro/system/import-user","content":"Each line must contain at least 3 columns and at most 5 columns: email, username, password, display name, user profile. (Display name and user profile are optional.)Please use UTF-8 encoding, otherw