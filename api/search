g the plugin, you should find a script named migrateHustoj in Control Panel > Script Management.\nIts parameter format is as follows:"},"900":{"id":"/en/docs/Hydro/plugins/migrate-15","page_id":"/en/docs/Hydro/plugins/migrate","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/migrate#upgrade-from-hustoj","content":"This information can usually be found in /home/judge/src/web/include/db_info.inc.php;"},"901":{"id":"/en/docs/Hydro/plugins/migrate-16","page_id":"/en/docs/Hydro/plugins/migrate","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/migrate#upgrade-from-hustoj","content":"host: database host (DB_HOST)"},"902":{"id":"/en/docs/Hydro/plugins/migrate-17","page_id":"/en/docs/Hydro/plugins/migrate","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/migrate#upgrade-from-hustoj","content":"port: database port (DB_PORT)"},"903":{"id":"/en/docs/Hydro/plugins/migrate-18","page_id":"/en/docs/Hydro/plugins/migrate","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/migrate#upgrade-from-hustoj","content":"name: database name, usually jol (DB_NAME)"},"904":{"id":"/en/docs/Hydro/plugins/migrate-19","page_id":"/en/docs/Hydro/plugins/migrate","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/migrate#upgrade-from-hustoj","content":"username&password: account/password, use empty strings if none (DB_USER/DB_PASS)"},"905":{"id":"/en/docs/Hydro/plugins/migrate-20","page_id":"/en/docs/Hydro/plugins/migrate","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/migrate#upgrade-from-hustoj","content":"domainId: target domain for migration, default is system"},"906":{"id":"/en/docs/Hydro/plugins/migrate-21","page_id":"/en/docs/Hydro/plugins/migrate","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/migrate#upgrade-from-hustoj","content":"contestType: oi or acm, depending on your setup (OJ_OI_MODE)"},"907":{"id":"/en/docs/Hydro/plugins/migrate-22","page_id":"/en/docs/Hydro/plugins/migrate","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/migrate#upgrade-from-hustoj","content":"dataDir: location of the data folder in HUSTOJ (stores critical data such as problem test data; requires manual handling) (OJ_DATA)"},"908":{"id":"/en/docs/Hydro/plugins/migrate-23","page_id":"/en/docs/Hydro/plugins/migrate","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/migrate#upgrade-from-hustoj","content":"uploadDir: location of uploaded files in HUSTOJ (stores uploaded images and files, usually /home/judge/src/web/upload/)"},"909":{"id":"/en/docs/Hydro/plugins/migrate-24","page_id":"/en/docs/Hydro/plugins/migrate","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/migrate#upgrade-from-hustoj","content":"After the script finishes, restart the Hydro instance to automatically complete the remaining upgrade steps.\nAfter migration, log in using the original HUSTOJ administrator account."},"910":{"id":"/en/docs/Hydro/plugins/migrate-25","page_id":"/en/docs/Hydro/plugins/migrate","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/migrate#upgrade-from-syzoj","content":"The migration process for SYZOJ is similar to HUSTOJ. Run the script named migrateSyzoj; unlike HUSTOJ migration, contestType is not required.\nIts parameter format is as follows:"},"911":{"id":"/en/docs/Hydro/plugins/migrate-26","page_id":"/en/docs/Hydro/plugins/migrate","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/migrate#upgrade-from-syzoj","content":"host: database host"},"912":{"id":"/en/docs/Hydro/plugins/migrate-27","page_id":"/en/docs/Hydro/plugins/migrate","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/migrate#upgrade-from-syzoj","content":"port: database port"},"913":{"id":"/en/docs/Hydro/plugins/migrate-28","page_id":"/en/docs/Hydro/plugins/migrate","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/migrate#upgrade-from-syzoj","content":"name: database name, usually syzoj"},"914":{"id":"/en/docs/Hydro/plugins/migrate-29","page_id":"/en/docs/Hydro/plugins/migrate","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/migrate#upgrade-from-syzoj"