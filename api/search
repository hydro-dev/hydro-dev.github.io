s, register scoreboards, and perform related operations."},"352":{"id":"/en/docs/Hydro/dev/PERM_PRIV","page_id":"/en/docs/Hydro/dev/PERM_PRIV","type":"page","content":"Permissions and Privileges","breadcrumbs":["Docs","Hydro","Development"],"tags":[],"url":"/en/docs/Hydro/dev/PERM_PRIV"},"353":{"id":"/en/docs/Hydro/dev/PERM_PRIV-0","page_id":"/en/docs/Hydro/dev/PERM_PRIV","tags":[],"type":"text","url":"/en/docs/Hydro/dev/PERM_PRIV","content":"Hydro permissions are handled using bitwise operations.Example: if a user has both PRIV_EDIT_SYSTEM and PRIV_SET_PERM permissions, it should be set to (1<<0)|(1<<1) (that is, 3)"},"354":{"id":"/en/docs/Hydro/dev/PERM_PRIV-1","page_id":"/en/docs/Hydro/dev/PERM_PRIV","tags":[],"type":"text","url":"/en/docs/Hydro/dev/PERM_PRIV","content":"You can check the relevant section in the source code."},"355":{"id":"/en/docs/Hydro/dev/PERM_PRIV-2","page_id":"/en/docs/Hydro/dev/PERM_PRIV","tags":[],"type":"text","url":"/en/docs/Hydro/dev/PERM_PRIV","content":"Further reading: Permission Structure"},"356":{"id":"/en/docs/Hydro/dev/db-layout","page_id":"/en/docs/Hydro/dev/db-layout","type":"page","content":"Database Layout","breadcrumbs":["Docs","Hydro","Development"],"tags":[],"url":"/en/docs/Hydro/dev/db-layout"},"357":{"id":"/en/docs/Hydro/dev/db-layout-0","page_id":"/en/docs/Hydro/dev/db-layout","type":"heading","tags":[],"url":"/en/docs/Hydro/dev/db-layout#core-collections","content":"Core Collections"},"358":{"id":"/en/docs/Hydro/dev/db-layout-1","page_id":"/en/docs/Hydro/dev/db-layout","type":"heading","tags":[],"url":"/en/docs/Hydro/dev/db-layout#document","content":"document"},"359":{"id":"/en/docs/Hydro/dev/db-layout-2","page_id":"/en/docs/Hydro/dev/db-layout","type":"heading","tags":[],"url":"/en/docs/Hydro/dev/db-layout#documentstatus","content":"document.status"},"360":{"id":"/en/docs/Hydro/dev/db-layout-3","page_id":"/en/docs/Hydro/dev/db-layout","type":"heading","tags":[],"url":"/en/docs/Hydro/dev/db-layout#record","content":"r