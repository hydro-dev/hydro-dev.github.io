ntent":"This document is outdated and kept only for archival purposes. The tutorial below is intended only as an example. For detailed installation instructions, please refer to the FAQs (Common Tutorials) for specific usage guidance."},"968":{"id":"/en/docs/Hydro/plugins/vjudge-4","page_id":"/en/docs/Hydro/plugins/vjudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/vjudge","content":"Some supported remote sites impose limits on submission count, access frequency, and request origin. Hydro does not guarantee 100% availability of VJudge."},"969":{"id":"/en/docs/Hydro/plugins/vjudge-5","page_id":"/en/docs/Hydro/plugins/vjudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/vjudge#codeforces","content":"After installing the plugin, create a domain named codeforces, then enter the database command: db.domain.updateOne({_id:'codeforces'},{$set:{mount:'codeforces'}});"},"970":{"id":"/en/docs/Hydro/plugins/vjudge-6","page_id":"/en/docs/Hydro/plugins/vjudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/vjudge#codeforces","content":"In the codeforces domain settings, configure allowedLangs as follows (in newer versions, simply select all languages prefixed with codeforces in the allowed submission languages):"},"971":{"id":"/en/docs/Hydro/plugins/vjudge-7","page_id":"/en/docs/Hydro/plugins/vjudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/vjudge#codeforces","content":"Insert the following entry into the vjudge table:"},"972":{"id":"/en/docs/Hydro/plugins/vjudge-8","page_id":"/en/docs/Hydro/plugins/vjudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/vjudge#codeforces","content":"Add the following configuration to the end of the langs settings:"},"973":{"id":"/en/docs/Hydro/plugins/vjudge-9","page_id":"/en/docs/Hydro/plugins/vjudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/vjudge#codeforces","content":"After that, restart Hydro."},"974":{"id":"/en/docs/Hydro/system/cdn","page_id":"/en/docs/Hydro/system/cdn","type":"page","content":"Use a Content Delivery Network","breadcrumbs":["Docs","Hydro","System Documentation"],"tags":[],"url":"/en/docs/Hydro/system/cdn"},"975":{"id":"/en/docs/Hydro/system/cdn-0","page_id":"/en/docs/Hydro/system/cdn","type":"heading","tags":[],"url":"/en/docs/Hydro/system/cdn#overview","content":"Overview"},"976":{"id":"/en/docs/Hydro/system/cdn-1","page_id":"/en/docs/Hydro/system/cdn","type":"heading","tags":[],"url":"/en/docs/Hydro/system/cdn#static-resource-cdn","content":"Static Resource CDN"},"977":{"id":"/en/docs/Hydro/system/cdn-2","page_id":"/en/docs/Hydro/system/cdn","type":"heading","tags":[],"url":"/en/docs/Hydro/system/cdn#full-site-cdn-acceleration","content":"Full-Site CDN (Acceleration)"},"978":{"id":"/en/docs/Hydro/system/cdn-3","page_id":"/en/docs/Hydro/system/cdn","type":"heading","tags":[],"url":"/en/docs/Hydro/system/cdn#recommended-cache-settings","content":"Recommended Cache Settings:"},"979":{"id":"/en/docs/Hydro/system/cdn-4","page_id":"/en/docs/Hydro/system/cdn","type":"heading","tags":[],"url":"/en/docs/Hydro/system/cdn#ip-forwarding","content":"IP Forwarding:"},"980":{"id":"/en/docs/Hydro/system/cdn-5","page_id":"/en/docs/Hydro/system/cdn","tags":[],"type":"text","url":"/en/docs/Hydro/system/cdn#overview","content":"Using a Content Delivery Network (CDN) can significantly improve the performance and accessibility of your Hydro instance, especially if your server has limited bandwidth. In most cases, configuring a Static Resource CDN provides the best balance of performance gains and ease of setup."},"981":{"id":"/en/docs/Hydro/system/cdn-6","page_id":"/en/docs/Hydro/system/cdn","tags":[],"type":"text","url":"/en/docs/Hydro/system/cdn#static-resource-cdn","content":"To offload static assets (images, scripts, styles) to a CDN:"},"982":{"id":"/en/docs/Hydro/system/cdn-7","page_id":"/en/docs/Hydro/system/cdn","tags":[],"type":"text","url":"/en/docs/Hydro/system/cdn#static-resource-cdn","content":"Create a CDN distribution with your cloud provider."},"983":{"id":"/en/docs/Hydro/system/cdn-8","page_id":"/en/docs/Hydro/system/cdn","tags":[],"type":"text","url":"/en/docs/Hydro/system/cdn#static-resource-cdn","content":"Set the CDN origin to your Hydro server's address."},"984":{"id":"/en/docs/Hydro/system/cdn-9","page_id":"/en/docs/Hydro/system/cdn","tags":[],"type":"text","url":"/en/docs/Hydro/system/cdn#static-resource-cdn","content":"In the Hydro Control Panel, set server.cdn to your CDN domain (e.g., https://cdn.example.com/). Ensure it ends with a trailing slash."},"985":{"id":"/en/docs/Hydro/system/cdn-10","page_id":"/en/docs/Hydro/system/cdn","tags":[],"type":"text","url":"/en/docs/Hydro/system/cdn#static-resource-cdn","content":"Caching Configuration:"},"986":{"id":"/en/docs/Hydro/system/cdn-11","page_id":"/en/docs/Hydro/system/cdn","tags":[],"type":"text","url":"/en/docs/Hydro/system/cdn#static-resource-cdn","content":"Recommended cache duration: 1 week or longer."},"987":{"id":"/en/docs/Hydro/system/cdn-12","page_id":"/en/docs/Hydro/system/cdn","tags":[],"type":"text","url":"/en/docs/Hydro/system/cdn#static-resource-cdn","content":"CORS/Referer: Ensure the CDN allows Cross-Origin Resource Sharing (CORS) and permits requests with an empty Referer (common for anti-leech settings)."},"988":{"id":"/en/docs/Hydro/system/cdn-13","page_id":"/en/docs/Hydro/system/cdn","tags":[],"type":"text","url":"/en/docs/Hydro/system/cdn#full-site-cdn-acceleration","content":"A full-site CDN proxies all traffic, including dynamic pages."},"989":{"id":"/en/docs/Hydro/system/cdn-14","page_id":"/en/docs/Hydro/system/cdn","tags":[],"type":"text","url":"/en/docs/Hydro/system/cdn#full-site-cdn-acceleration","content":"type: warn"},"990":{"id":"/en/docs/Hydro/system/cdn-15","page_id":"/en/docs/Hydro/system/cdn","tags":[],"type":"text","url":"/en/docs/Hydro/system/cdn#full-site-cdn-acceleration","content":"Full-site CDN configuration is complex and varies significantly between providers. If you are inexperienced, we recommend using only a Static Resource CDN."},"991":{"id":"/en/docs/Hydro/system/cdn-16","page_id":"/en/docs/Hydro/system/cdn","tags":[],"type":"text","url":"/en/docs/Hydro/system/cdn#full-site-cdn-acceleration","content":"type: warn"},"992":{"id":"/en/docs/Hydro/system/cdn-17","page_id":"/en/docs/Hydro/system/cdn","tags":[],"type":"text","url":"/en/docs/Hydro/system/cdn#full-site-cdn-acceleration","content":"Critical Requirements for Full-Site CDNs:"},"993":{"id":"/en/docs/Hydro/system/cdn-18","page_id":"/en/docs/Hydro/system/cdn","tags":[],"type":"text","url":"/en/docs/Hydro/system/cdn#full-site-cdn-acceleration","content":"WebSocket Support: You must enable WebSocket support in your CDN settings. Without it, real-time features like judging status updates and the Online IDE will fail."},"994":{"id":"/en/docs/Hydro/system/cdn-19","page_id":"/en/docs/Hydro/system/cdn","tags":[],"type":"text","url":"/en/docs/Hydro/system/cdn#full-site-cdn-acceleration","content":"Dynamic Content Caching: Ensure that only static assets are cached. Caching dynamic pages (like login or profile pages) will lead to session inconsistencies and security issues."},"995":{"id":"/en/docs/Hydro/system/cdn-20","page_id":"/en/docs/Hydro/system/cdn","tags":[],"type":"text","url":"/en/docs/Hydro/system/cdn#recommended-cache-settings","content":"Type"},"996":{"id":"/en/docs/Hydro/system/cdn-21","page_id":"/en/docs/Hydro/system/cdn","tags":[],"type":"text","url":"/en/docs/Hydro/system/cdn#recommended-cache-settings","content":"Content"},"997":{"id":"/en/docs/Hydro/system/cdn-22","page_id":"/en/docs/Hydro/system/cdn","tags":[],"type":"text","url":"/en/docs/Hydro/system/cdn#recommended-cache-settings","content":"Cache Behavior"},"998":{"id":"/en/docs/Hydro/system/cdn-23","page_id":"/en/docs/Hydro/system/cdn","tags":[],"type":"text","url":"/en/docs/Hydro/system/cdn#recommended-cache-settings","content":"Dynamic"},"999":{"id":"/en/docs/Hydro/system/cdn-24","page_id":"/en/docs/Hydro/system/cdn","tags":[],"