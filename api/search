ype":"text","url":"/en/docs/Hydro/plugins/extra#authentication-and-security","content":"WeChat Login: Allows users to log in by scanning a WeChat QR code (Requires a verified WeChat Service Account)."},"720":{"id":"/en/docs/Hydro/plugins/extra-10","page_id":"/en/docs/Hydro/plugins/extra","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/extra#contest-tools","content":"Contest PDF: Instantly export all problem statements in a contest into a single, formatted PDF."},"721":{"id":"/en/docs/Hydro/plugins/extra-11","page_id":"/en/docs/Hydro/plugins/extra","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/extra#contest-tools","content":"Bulk Submit: Tools for offline contests (OI-style) to collect, package, and upload contestant code for centralized judging."},"722":{"id":"/en/docs/Hydro/plugins/extra-12","page_id":"/en/docs/Hydro/plugins/extra","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/extra#educational-features","content":"Course System: A comprehensive management suite for classes, handouts, and student progress tracking."},"723":{"id":"/en/docs/Hydro/plugins/extra-13","page_id":"/en/docs/Hydro/plugins/extra","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/extra#educational-features","content":"User Expiration: Automate access control based on subscription or enrollment periods."},"724":{"id":"/en/docs/Hydro/plugins/extra-14","page_id":"/en/docs/Hydro/plugins/extra","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/extra#educational-features","content":"Blockly: Integrated block-based visual programming for beginners."},"725":{"id":"/en/docs/Hydro/plugins/extra-15","page_id":"/en/docs/Hydro/plugins/extra","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/extra#ui-and-ux","content":"Swiper: A customizable carousel banner for the site homepage."},"726":{"id":"/en/docs/Hydro/plugins/extra-16","page_id":"/en/docs/Hydro/plugins/extra","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/extra#ui-and-ux","content":"History Charts: Visual representation of user rating and submission frequency history."},"727":{"id":"/en/docs/Hydro/plugins/extra-17","page_id":"/en/docs/Hydro/plugins/extra","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/extra#ui-and-ux","content":"User Management Panel: An enhanced, one-stop web interface for administrators to manage users and permissions."},"728":{"id":"/en/docs/Hydro/plugins/extra-18","page_id":"/en/docs/Hydro/plugins/extra","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/extra#advanced-capabilities","content":"AI Integration: AI-driven bug detection, problem Q&A, and solution analysis."},"729":{"id":"/en/docs/Hydro/plugins/extra-19","page_id":"/en/docs/Hydro/plugins/extra","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/extra#advanced-capabilities","content":"Turtle/GOC Graphics: Specialized environments for Turtle graphics and GOC programming."},"730":{"id":"/en/docs/Hydro/plugins/extra-20","page_id":"/en/docs/Hydro/plugins/extra","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/extra#external-problem-sets","content":"We provide access to high-quality mirrors for popular competitive programming platforms:"},"731":{"id":"/en/docs/Hydro/plugins/extra-21","page_id":"/en/docs/Hydro/plugins/extra","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/extra#external-problem-sets","content":"Mirror Services: For LOJ, AtCoder, and BZOJ, we maintain dedicated mirrors with complete test data. We charge a nominal operational fee of 0.002 CNY per submission."},"732":{"id":"/en/docs/Hydro/plugins/extra-22","page_id":"/en/docs/Hydro/plugins/extra","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/extra#external-problem-sets","content":"Self-Hosting Data:"},"733":{"id":"/en/docs/Hydro/plugins/extra-23","page_id":"/en/docs/Hydro/plugins/extra","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/extra#external-problem-sets","content":"LOJ: Use loj-download (~180GB)."},"734":{"id":"/en/docs/Hydro/plugins/extra-24","page_id":"/en/docs/Hydro/plugins/extra","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/extra#external-problem-sets","content":"AtCoder: Public test data downloads are no longer provided."},"735":{"id":"/en/docs/Hydro/plugins/extra-25","page_id":"/en/docs/Hydro/plugins/extra","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/extra#external-problem-sets","content":"BZOJ: Please search for third-party sources (approx. 64GB)."},"736":{"id":"/en/docs/Hydro/plugins/extra-26","page_id":"/en/docs/Hydro/plugins/extra","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/extra#external-problem-sets","content":"Luogu Integration: Remote judging for Luogu is available through the Luogu Open Platform. This service is managed by Luogu. Alternatively, you can purchase authorization directly through Hydro at a discounted channel rate."},"737":{"id":"/en/docs/Hydro/plugins/fps-importer","page_id":"/en/docs/Hydro/plugins/fps-importer","type":"page","content":"fps-importer","breadcrumbs":["Docs","Hydro","Plugins"],"tags":[],"url":"/en/docs/Hydro/plugins/fps-importer"},"738":{"id":"/en/docs/Hydro/plugins/fps-importer-0","page_id":"/en/docs/Hydro/plugins/fps-importer","type":"heading","tags":[],"url":"/en/docs/Hydro/plugins/fps-importer#import-problems-from-fps-files","content":"Import Problems from FPS Files"},"739":{"id":"/en/docs/Hydro/plugins/fps-importer-1","page_id":"/en/docs/Hydro/plugins/fps-importer","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/fps-importer#import-problems-from-fps-files","content":"In the problemset page, choose \"Import from FPS file\" under the \"Create Problem\" section on the right.\nIn the opened window, you can upload:"},"740":{"id":"/en/docs/Hydro/plugins/fps-importer-2","page_id":"/en/docs/Hydro/plugins/fps-importer","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/fps-importer#import-problems-from-fps-files","content":"an XML file in fps format"},"741":{"id":"/en/docs/Hydro/plugins/fps-importer-3","page_id":"/en/docs/Hydro/plugins/fps-importer","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/fps-importer#import-problems-from-fps-files","content":"a zip file that contains one or more XML files in fps format"},"742":{"id":"/en/docs/Hydro/plugins/fps-importer-4","page_id":"/en/docs/Hydro/plugins/fps-importer","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/fps-importer#import-problems-from-fps-files","content":"To prevent parsing fps files from consuming excessive memory, the system rejects files larger than 64MiB by default;\nXML files must use UTF-8 encoding, otherwise Chinese problem statements may become garbled;\nIn newer versions of fps-importer, administrators can modify the import file size limit, but note that we still do not recommend importing overly large problem packages.\nIf your file exceeds the size limit, consider splitting it locally first with tools such as Easy-Fps-Viewer."},"743":{"id":"/en/docs/Hydro/plugins/geoip","page_id":"/en/docs/Hydro/plugins/geoip","type":"page","content":"GeoIP","breadcrumbs":["Docs","Hydro","Plugins"],"tags":[],"url":"/en/docs/Hydro/plugins/geoip"},"744":{"id":"/en/docs/Hydro/plugins/geoip-0","page_id":"/en/docs/Hydro/plugins/geoip","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/geoip","content":"This plugin requires MaxMind's Geolite2-City.mmdb. After installing the plugin, you need to copy the mmdb file to the same directory as the plugin to enable it. If you don't know what this is, do not install it."},"745":{"id":"/en/docs/Hydro/plugins/hydrojudge","page_id":"/en/docs/Hydro/plugins/hydrojudge","type":"page","content":"hydrojudge","breadcrumbs":["Docs","Hydro","Plugins"],"tags":[],"url":"/en/docs/Hydro/plugins/hydrojudge"},"746":{"id":"/en/docs/Hydro/plugins/hydrojudge-0","page_id":"/en/docs/Hydro/plugins/hydrojudge","type":"heading","tags":[],"url":"/en/docs/Hydro/plugins/hydrojudge#preparation","content":"Preparation"},"747":{"id":"/en/docs/Hydro/plugins/hydrojudge-1","page_id":"/en/docs/Hydro/plugins/hydrojudge","type":"heading","tags":[],"url":"/en/docs/Hy