ge_id":"/en/docs/Hydro/FAQ/debug","tags":[],"type":"text","url":"/en/docs/Hydro/FAQ/debug#debugging-hydrooj","content":"Back up your plugin list: cp ~/.hydro/addon.json ~/.hydro/addon.json.bak."},"224":{"id":"/en/docs/Hydro/FAQ/debug-18","page_id":"/en/docs/Hydro/FAQ/debug","tags":[],"type":"text","url":"/en/docs/Hydro/FAQ/debug#debugging-hydrooj","content":"View active plugins: hydrooj addon list."},"225":{"id":"/en/docs/Hydro/FAQ/debug-19","page_id":"/en/docs/Hydro/FAQ/debug","tags":[],"type":"text","url":"/en/docs/Hydro/FAQ/debug#debugging-hydrooj","content":"Remove non-official plugins (those without the @hydrooj/ prefix): hydrooj addon remove <name>."},"226":{"id":"/en/docs/Hydro/FAQ/debug-20","page_id":"/en/docs/Hydro/FAQ/debug","tags":[],"type":"text","url":"/en/docs/Hydro/FAQ/debug#debugging-hydrooj","content":"Restart: Check if the system runs correctly without third-party plugins. If it does, re-enable them one by one to identify the culprit."},"227":{"id":"/en/docs/Hydro/FAQ/debug-21","page_id":"/en/docs/Hydro/FAQ/debug","tags":[],"type":"text","url":"/en/docs/Hydro/FAQ/debug#debugging-hydrooj","content":"Support: If the issue persists, provide the development team with the full console output from startup until the error occurs."},"228":{"id":"/en/docs/Hydro/FAQ/debug-22","page_id":"/en/docs/Hydro/FAQ/debug","tags":[],"type":"text","url":"/en/docs/Hydro/FAQ/debug#frontend-issues","content":"Symptoms include pages failing to load, infinite loading spinners, or error prompts (yellow/red) at the bottom-left of the screen."},"229":{"id":"/en/docs/Hydro/FAQ/debug-23","page_id":"/en/docs/Hydro/FAQ/debug","tags":[],"type":"text","url":"/en/docs/Hydro/FAQ/debug#frontend-issues","content":"Clear Cache: Press Ctrl+Shift+Delete to clear your browser cache and reload."},"230":{"id":"/en/docs/Hydro/FAQ/debug-24","page_id":"/en/docs/Hydro/FAQ/debug","tags":[],"type":"text","url":"/en/docs/Hydro/FAQ/debug#frontend-issues","content":"Browser Version: Ensure you are usin