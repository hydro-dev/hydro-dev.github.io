guages"},"757":{"id":"/en/docs/Hydro/plugins/hydrojudge-11","page_id":"/en/docs/Hydro/plugins/hydrojudge","type":"heading","tags":[],"url":"/en/docs/Hydro/plugins/hydrojudge#debug-sandbox-environment","content":"Debug sandbox environment"},"758":{"id":"/en/docs/Hydro/plugins/hydrojudge-12","page_id":"/en/docs/Hydro/plugins/hydrojudge","type":"heading","tags":[],"url":"/en/docs/Hydro/plugins/hydrojudge#clear-data-cache","content":"Clear data cache"},"759":{"id":"/en/docs/Hydro/plugins/hydrojudge-13","page_id":"/en/docs/Hydro/plugins/hydrojudge","type":"heading","tags":[],"url":"/en/docs/Hydro/plugins/hydrojudge#test-data-format","content":"Test data format"},"760":{"id":"/en/docs/Hydro/plugins/hydrojudge-14","page_id":"/en/docs/Hydro/plugins/hydrojudge","type":"heading","tags":[],"url":"/en/docs/Hydro/plugins/hydrojudge#adjust-sandbox-storage-size","content":"Adjust sandbox storage size"},"761":{"id":"/en/docs/Hydro/plugins/hydrojudge-15","page_id":"/en/docs/Hydro/plugins/hydrojudge","type":"heading","tags":[],"url":"/en/docs/Hydro/plugins/hydrojudge#increase-program-stack-size","content":"Increase program stack size"},"762":{"id":"/en/docs/Hydro/plugins/hydrojudge-16","page_id":"/en/docs/Hydro/plugins/hydrojudge","type":"heading","tags":[],"url":"/en/docs/Hydro/plugins/hydrojudge#improve-judging-precision","content":"Improve judging precision"},"763":{"id":"/en/docs/Hydro/plugins/hydrojudge-17","page_id":"/en/docs/Hydro/plugins/hydrojudge","type":"heading","tags":[],"url":"/en/docs/Hydro/plugins/hydrojudge#inaccurate-memory-measurement","content":"Inaccurate memory measurement"},"764":{"id":"/en/docs/Hydro/plugins/hydrojudge-18","page_id":"/en/docs/Hydro/plugins/hydrojudge","type":"heading","tags":[],"url":"/en/docs/Hydro/plugins/hydrojudge#memory-controller-not-enabled","content":"Memory controller not enabled"},"765":{"id":"/en/docs/Hydro/plugins/hydrojudge-19","page_id":"/en/docs/Hydro/plugins/hydrojudge","type":"heading","tags":[],"url":"/en/docs/Hydro/plugins/hydrojudge#swap-limit-not-applied","content":"Swap limit not applied"},"766":{"id":"/en/docs/Hydro/plugins/hydrojudge-20","page_id":"/en/docs/Hydro/plugins/hydrojudge","type":"heading","tags":[],"url":"/en/docs/Hydro/plugins/hydrojudge#seccomp-not-enabled","content":"Seccomp not enabled"},"767":{"id":"/en/docs/Hydro/plugins/hydrojudge-21","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge","content":"You can quickly install a standalone judge machine with the one-click installation script. For details, see Deploy Hydro."},"768":{"id":"/en/docs/Hydro/plugins/hydrojudge-22","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#preparation","content":"Before configuring the judge machine, make sure your site is accessible and login/registration works normally."},"769":{"id":"/en/docs/Hydro/plugins/hydrojudge-23","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#preparation","content":"You should download compilers for the languages you want to support in advance. If you upgrade/reinstall compilers after configuring the judge machine, you need to restart the sandbox.\nFor compiler details, refer to the Compiler section."},"770":{"id":"/en/docs/Hydro/plugins/hydrojudge-24","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#preparation","content":"If you are not using the automatic script, you need to manually install the sandbox service as follows:\nGo to criyle/go-judge and download the go-judge build for your CPU architecture.\ngo-judge needs to run in the background and listen on 127.0.0.1:5050. If your system uses cgroup v1 or a distro without systemd init, run it as root.\nYou can manage it with pm2."},"771":{"id":"/en/docs/Hydro/plugins/hydrojudge-25","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-an-add-on","content":"Because a judge installed as an add-on must be on the same server as Hydro, each Hydro instance can have at most one add-on-installed judge machine."},"772":{"id":"/en/docs/Hydro/plugins/hydrojudge-26","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-an-add-on","content":"Run the following commands on the machine where Hydro is installed to install @hydrooj/hydrojudge:"},"773":{"id":"/en/docs/Hydro/plugins/hydrojudge-27","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-an-add-on","content":"After restarting Hydro, hydrojudge will run normally."},"774":{"id":"/en/docs/Hydro/plugins/hydrojudge-28","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-a-standalone-process","content":"This method helps you deploy judge machines on any server."},"775":{"id":"/en/docs/Hydro/plugins/hydrojudge-29","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-a-standalone-process","content":"type: warn"},"776":{"id":"/en/docs/Hydro/plugins/hydrojudge-30","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-a-standalone-process","content":"We recommend that all standalone judge machines use identical hardware and that you disable the built-in judge to ensure stable judging results.\nJudge-related options in System Settings only control the built-in judge. Standalone judges must be configured in judge.yaml."},"777":{"id":"/en/docs/Hydro/plugins/hydrojudge-31","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-a-standalone-process","content":"First, create an account with PRIV_JUDGE permission. See here for details. (Run this on the Hydro server)"},"778":{"id":"/en