/docs/Tools-11","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day--1-preparation","content":"DHCP can be used to configure contestant machine networking, but ensure lease duration is long enough (seven days recommended)."},"155":{"id":"/en/docs/Tools-12","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day--1-preparation","content":"About server setup:"},"156":{"id":"/en/docs/Tools-13","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day--1-preparation","content":"The server uses a static IP and can access any device in the internal network (including contestant machines);"},"157":{"id":"/en/docs/Tools-14","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day--1-preparation","content":"The server runs Linux with a relatively new kernel. Older kernel versions are known to potentially freeze under high load details;"},"158":{"id":"/en/docs/Tools-15","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day--1-preparation","content":"About the CAICPC image:"},"159":{"id":"/en/docs/Tools-16","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day--1-preparation","content":"This image is modified from the standard ICPC image."},"160":{"id":"/en/docs/Tools-17","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day--1-preparation","content":"Added status reporting for unified server status monitoring;"},"161":{"id":"/en/docs/Tools-18","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day--1-preparation","content":"Supports calling VLC to capture screen and camera streams for the live module;"},"162":{"id":"/en/docs/Tools-19","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day--1-preparation","content":"Supports batch dispatch of management commands (one-click lock screen / unlock / reboot / show seat number, etc.);"},"163":{"id":"/en/docs/Tools-20","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day-0-preparation","content":"Install Hydro using the installation script."},"164":{"id":"/en/docs/Tools-21","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day-0-preparation","content":"Import required contest users."},"165":{"id":"/en/docs/Tools-22","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day-0-preparation","content":"Install the @hydrooj/onsite-toolkit plugin."},"166":{"id":"/en/docs/Tools-23","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day-0-preparation","content":"Install standalone modules by following https://github.com/hydro-dev/xcpc-tools."},"167":{"id":"/en/docs/Tools-24","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day-0-preparation","content":"Volunteers open the seat.txt file on all contestant desktops, fill in seat numbers, save; seat numbers shown in the backend should refresh synchronously;"},"168":{"id":"/en/docs/Tools-25","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day-0-preparation","content":"If automatic login by seat number is needed, export the IP/team table and fill it in onsite-toolkit settings."},"169":{"id":"/en/docs/Tools-26","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day-0-preparation","content":"After preparation is complete, batch-change contestant machine passwords to strong passwords!!!"},"170":{"id":"/en/docs/Tools-27","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day-0-preparation","content":"// TODO: tools configuration"},"171":{"id":"/en/docs/Tools-28","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day-0-preparation","content":"About printing:"},"172":{"id":"/en/docs/Tools-29","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day-0-preparation","content":"Printing is configured in xcpc-tools."},"173":{"id":"/en/docs/Tools-30","page_