cs/Hydro/api/judge#test-data-download","content":"Test Data Download"},"339":{"id":"/en/docs/Hydro/api/judge-5","page_id":"/en/docs/Hydro/api/judge","type":"heading","tags":[],"url":"/en/docs/Hydro/api/judge#judge-result-reporting","content":"Judge Result Reporting"},"340":{"id":"/en/docs/Hydro/api/judge-6","page_id":"/en/docs/Hydro/api/judge","tags":[],"type":"text","url":"/en/docs/Hydro/api/judge","content":"Current version: v1."},"341":{"id":"/en/docs/Hydro/api/judge-7","page_id":"/en/docs/Hydro/api/judge","tags":[],"type":"text","url":"/en/docs/Hydro/api/judge#judge-side-interaction-flow","content":"GET /judge/files (check whether login status is valid; if invalid, enter login flow; usually executed once every six hours)"},"342":{"id":"/en/docs/Hydro/api/judge-8","page_id":"/en/docs/Hydro/api/judge","tags":[],"type":"text","url":"/en/docs/Hydro/api/judge#judge-side-interaction-flow","content":"WEBSOCKET /judge/conn (main interaction channel)"},"343":{"id":"/en/docs/Hydro/api/judge-9","page_id":"/en/docs/Hydro/api/judge","tags":[],"type":"text","url":"/en/docs/Hydro/api/judge#judge-side-interaction-flow","content":"If login has expired, perform login."},"344":{"id":"/en/docs/Hydro/api/judge-10","page_id":"/en/docs/Hydro/api/judge","tags":[],"type":"text","url":"/en/docs/Hydro/api/judge#websocket-connection-establishment-flow","content":"After the connection is established, the judge reports current node status to Web (optional)Note: the information below is only for data format demonstration and is not guaranteed to be real or valid."},"345":{"id":"/en/docs/Hydro/api/judge-11","page_id":"/en/docs/Hydro/api/judge","tags":[],"type":"text","url":"/en/docs/Hydro/api/judge#websocket-connection-establishment-flow","content":"After connection establishment, the judge sends {\"key\":\"ping\"} every 30s."},"346":{"id":"/en/docs/Hydro/api/judge-12","page_id":"/en/docs/Hydro/api/judge","tags":[],"type":"text","url":"/en/docs/Hydro/api/judge#language-configuration-distributi