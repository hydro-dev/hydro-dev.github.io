ge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-an-add-on-1","content":"Modify parameters in System Settings > hydrojudge, then restart Hydro and hydrojudge."},"786":{"id":"/en/docs/Hydro/plugins/hydrojudge-40","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-a-standalone-process-1","content":"If you need to change settings such as the maximum number of test cases per problem, add the following at the end of ~/.config/hydro/judge.yaml:"},"787":{"id":"/en/docs/Hydro/plugins/hydrojudge-41","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-a-standalone-process-1","content":"All settings listed here can be added here."},"788":{"id":"/en/docs/Hydro/plugins/hydrojudge-42","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#modify-compiler-options--add-support-for-new-languages","content":"Modify hydrooj.langs in Control Panel > System Settings (applies to all judge machines connected to this server)\nor configure it in ~/.config/hydro/langs.yaml (applies to a single standalone judge machine, not recommended)."},"789":{"id":"/en/docs/Hydro/plugins/hydrojudge-43","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#modify-compiler-options--add-support-for-new-languages","content":"For file format, see here."},"790":{"id":"/en/docs/Hydro/plugins/hydrojudge-44","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#modify-compiler-options--add-support-for-new-languages","content":"If you added a new language, you also need to modify Language Highlight ID and Monaco language modes in Control Panel > System Settings.\nThese define syntax highlighting (based on PrismJS) and Monaco editor language mode respectively after selecting that language."},"791":{"id":"/en/docs/Hydro/plugins/hydrojudge-45","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#modify-compiler-options--add-support-for-new-languages","content":"After modification, restart Hydro and hydrojudge."},"792":{"id":"/en/docs/Hydro/plugins/hydrojudge-46","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#modify-compiler-options--add-support-for-new-languages","content":"See more in the Compilers and Languages section."},"793":{"id":"/en/docs/Hydro/plugins/hydrojudge-47","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#debug-sandbox-environment","content":"If you need to debug compilation/runtime errors in the sandbox, use hydrojudge terminal to open an interactive judge terminal. This terminal runs in an isolated sandbox identical to the judging environment."},"794":{"id":"/en/docs/Hydro/plugins/hydrojudge-48","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#clear-data-cache","content":"To clear judging data cache, use hydrojudge cache prune to remove test data unused for 30 days. To specify days, add parameter --duration=x to clear data unused for x days."},"795":{"id":"/en/docs/Hydro/plugins/hydrojudge-49","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#clear-data-cache","content":"To clear all cached data, use hydrojudge cache clean."},"796":{"id":"/en/docs/Hydro/plugins/hydrojudge-50","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#test-data-format","content":"Configure according to Test Data Format."},"797":{"id":"/en/docs/Hydro/plugins/hydrojudge-51","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#adjust-sandbox-storage-size","content":"type: warn"},"798":{"id":"/en/docs/Hydro/plugins/hydrojudge-52","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#adjust-sandbox-storage-size","content":"If you do not adjust sandbox storage size, judging with file I/O and large input/output files may cause errors."},"799":{"id":"/en/docs/Hydro/plugins/hydrojudge-53","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#adjust-sandbox-storage-size","content":"For users installed before 2022/8/12:"},"800":{"id":"/en/docs/Hydro/plugins/hydrojudge-54","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#adjust-sandbox-storage-size","content":"Run the following on the server to find the runtime directory of hydro-sandbox:"},"801":{"id":"/en/docs/Hydro/plugins/hydrojudge-55","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#adjust-sandbox-storage-size","content":"Refer to custom mount configuration in Sandbox filesystem mount documentation, save it in the runtime directory as mount.yaml.\nModify size and nr_inodes mount parameters for work dir and tmp dir to your desired values, save, then restart hydro-sandbox to apply."},"802":{"id":"/en/docs/Hydro/plugins/hydrojudge-56","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#adjust-sandbox-storage-size","content":"For users installed after 2022/8/12:"},"803":{"id":"/en/docs/Hydro/plugins/hydrojudge-57","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#adjust-sandbox-storage-size","content":"Edit /root/.hydro/mount.yaml and modify size."},"804":{"id":"/en/docs/Hydro/plugins/hydrojudge-58","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#increase-program-stack-size","content":"Instances installed after 2022/8/12 already have unlimited stack size enabled by default; no manual action needed"},"805":{"id":"/en/docs/Hydro/plugins/hydrojudge-59","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#increase-program-stack-size","content":"In many cases, the default stack size provided by the system is insufficient. You need to manually provide a larger stack for user programs."},"806":{"id":"/en/docs/Hydro/plugins/hydrojudge-60","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#increase-program-stack-size","content":"Modify hydro-sandbox startup arguments in pm2 to ulimit -s unlimited && /usr/bin/hydro-sandbox:"},"807":{"id":"/en/docs/Hydro/plugins/hydrojudge-61","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#improve-judging-precision","content":"Disable CPU frequency scaling and Intel Turbo Boost to avoid CPU frequency fluctuations."},"808":{"id":"/en/docs/Hydro/plugins/hydrojudge-62","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#improve-judging-precision","content":"Disable ASLR so code with memory addressing errors can produce more reproducible results. Add the following line in /etc/sysctl.conf and run sudo sysctl -p:"},"809":{"id":"/en/docs/Hydro/plugins/hydrojudge-63","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#improve-judging-precision","content":"Enable sandbox CPU affinity. For example, on an 8-core system, to restrict judging tasks to CPU 2,4,6, use:"},"810":{"id":"/en/docs/Hydro/plugins/hydrojudge-64","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#improve-judging-precision","content":"Then the maximum number of concurrent tasks is the number of cores separated by , (in this example, 3), and each concurrent judging task is assigned one core in the configuration. When enabling this option, parallelism is recommended to match the number of cores available to sandbox tasks. This setting should be tuned based on the judge machine's CPU specifics (such as hyper-threading, NUMA, etc.). It also requires sandbox version v1.11.2 or above."},"811":{"id":"/en/docs/Hydro/plugins/hydrojudge-65","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#improve-judging-precision","content":"Also, to prevent other tasks from using those cores, you can use isolcpus kernel parameter. For example, on an 8-core system, to prevent other tasks from using CPU 2-7, add isolcpus=2-7 to kernel boot parameters. See Inaccurate memory measurement for how to modify kernel boot parameters."},"812":{"id":"/en/docs/Hydro/plugins/hydrojudge-66","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#inaccurate-memory-measurement","content":"If you see warning You are using cgroup v2 without kernel 5.19+. This could result in inaccurate memory usage measurements. in the control panel, it means current memory usage measurement has error."},"813":{"id":"/en/docs/Hydro/plugins/hydrojudge-67","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#inaccurate-memory-measurement","content":"Some Linux devices use cgroup2 by default, and cgroup2 kernels before 5.19 removed interfaces for precise memory usage accounting.\nFor more accurate memory measurement, enabling cgroup v1 is recommended (you can verify whether cgroup v1 is enabled by checking if /sys/fs/cgroup/memory/memory.memsw.usage_in_bytes exists):"},"814":{"id":"/en/docs/Hydro/plugins/hydrojudge-68","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#inaccurate-memory-measurement","content":"Using Ubuntu's default bootloader GRUB 2 as an example, edit /etc/default/grub:\nIn"},"815":{"id":"/en/docs/Hydro/plugins/hydrojudge-69","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#inaccurate-memory-measurement","content":"add cgroup_enable=memory swapaccount=1 systemd.unified_cgroup_hierarchy=0, so it becomes:"},"816":{"id":"/en/docs/Hydro/plugins/hydrojudge-70","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#inaccurate-memory-measurement","content":"Run the following command to update GRUB 2 config, then reboot."},"817":{"id":"/en/docs/Hydro/plugins/hydrojudge-71","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#memory-controller-not-enabled","content":"If you see warning The memory cgroup controller is not enabled. This could result in inaccurate memory usage measurements. in the control panel, it means the memory cgroup controller is not enabled on current system."},"818":{"id":"/en/docs/Hydro/plugins/hydrojudge-72","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#memory-controller-not-enabled","content":"Some Linux systems (such as Raspbian) do not enable the memory cgroup controller by default. Enabling it provides more accurate memory limits and measurements."},"819":{"id":"/en/docs/Hydro/plugins/hydrojudge-73","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#memory-controller-not-enabled","content":"Using Raspbian as an example, edit /boot/firmware/cmdline.txt (or /boot/cmdline.txt if it does not exist):\nAdd the following at the end (note the space)"},"820":{"id":"/en/docs/Hydro/plugins/hydrojudge-74","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#memory-controller-not-enabled","content":"After reboot, check /proc/cgroups to confirm memory controller memory is enabled."},"821":{"id":"/en/docs/Hydro/plugins/hydrojudge-75","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#swap-limit-not-applied","content":"If Hydro displays the following warning, go-judge has not reported swap limiting as enabled. Memory limits may not restrict swap use, and memory usage measurements may be inaccurate:"},"822":{"id":"/en/docs/Hydro/plugins/hydrojudge-76","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#swap-limit-not-applied","content":"go-judge swap limits are unavailable. Memory limits may not restrict swap use, and memory usage measurements may be inaccurate."},"823":{"id":"/en/docs/Hydro/plugins/hydrojudge-77","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#swap-limit-not-applied","content":"Check that the system provides and enables swap accounting and memory cgroup limits. The rlimit/rusage fallback mode cannot enforce swap limits. See Inaccurate memory measurement for how to add swapaccount=1 to the kernel boot parameters."},"824":{"id":"/en/docs/Hydro/plugins/hydrojudge-78","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#seccomp-not-enabled","content":"If Hydro displays the following warning, go-judge has seccomp disabled and sandbox isolation is reduced:"},"825":{"id":"/en/docs/Hydro/plugins/hydrojudge-79","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#seccomp-not-enabled","content":"Seccomp is not enabled in go-judge. This reduces sandbox isolation."},"826":{"id":"/en/docs/Hydro/plugins/hydrojudge-80","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#seccomp-not-enabled","content":"Check the go-judge runtime environment and startup configuration to make sure seccomp is available and enabled, then restart go-judge."},"827":{"id":"/en/docs/Hydro/plugins/hydrojudge-81","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#seccomp-not-enabled","content":"Older go-judge versions may not support seccomp. If your version does not support it, upgrade to the latest release, enable seccomp, and restart the service."},"828":{"id":"/en/docs/Hydro/plugins/hydrojudge-82","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#seccomp-not-enabled","content":"If the host kernel has an exploitable privilege escalation vulnerability, the lack of seccomp restrictions may further increase the risk that a sandboxed program could use it to affect the host. Make sure seccomp is enabled in go-judge and keep the host kernel up to date."},"829":{"id":"/en/docs/Hydro/plugins","page_id":"/en/docs/Hydro/plugins","type":"page","content":"Plugins","breadcrumbs":["Docs","Hydro","Plugins"],"tags":[],"url":"/en/docs/Hydro/plugins"},"830":{"id":"/en/docs/Hydro/plugins-0","page_id":"/en/docs/Hydro/plugins","type":"heading","tags":[],"url":"/en/docs/Hydro/plugins#add-on-list","content":"Add-on List"},"831":{"id":"/en/docs/Hydro/plugins-1","page_id":"/en/docs/Hydro/plugins","type":"heading","tags":[],"url":"/en/docs/Hydro/plugins#installation","content":"Installation"},"832":{"id":"/en/docs/Hydro/plugins-2","page_id":"/en/docs/Hydro/plugins","type":"heading","tags":[],"url":"/en/docs/Hydro/plugins#view-registered-plugin-list","content":"View Registered Plugin List"},"833":{"id":"/en/docs/Hydro/plugins-3","page_id":"/en/docs/Hydro/plugins","type":"heading","tags":[],"url":"/en/docs/Hydro/plugins#update","content":"Update"},"834":{"id":"/en/docs/Hydro/plugins-4","page_id":"/en/docs/Hydro/plugins","type":"heading","tags":[],"url":"/en/docs/Hydro/plugin