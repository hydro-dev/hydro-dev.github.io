ractive --latest"},"314":{"id":"/en/docs/Hydro/FAQ/upgrade-7","page_id":"/en/docs/Hydro/FAQ/upgrade","tags":[],"type":"text","url":"/en/docs/Hydro/FAQ/upgrade#recommended-upgrade-path","content":"Use the spacebar to select all packages except for pm2."},"315":{"id":"/en/docs/Hydro/FAQ/upgrade-8","page_id":"/en/docs/Hydro/FAQ/upgrade","tags":[],"type":"text","url":"/en/docs/Hydro/FAQ/upgrade#recommended-upgrade-path","content":"Press Enter to confirm."},"316":{"id":"/en/docs/Hydro/FAQ/upgrade-9","page_id":"/en/docs/Hydro/FAQ/upgrade","tags":[],"type":"text","url":"/en/docs/Hydro/FAQ/upgrade#recommended-upgrade-path","content":"Restart the service: pm2 restart hydrooj"},"317":{"id":"/en/docs/Hydro/FAQ/upgrade-10","page_id":"/en/docs/Hydro/FAQ/upgrade","tags":[],"type":"text","url":"/en/docs/Hydro/FAQ/upgrade#recommended-upgrade-path","content":"Verify success: Check logs with pm2 logs hydrooj --lines 100. Look for the \"Server started\" message."},"318":{"id":"/en/docs/Hydro/FAQ/upgrade-11","page_id":"/en/docs/Hydro/FAQ/upgrade","tags":[],"type":"text","url":"/en/docs/Hydro/FAQ/upgrade#recommended-upgrade-path","content":"Important Considerations:"},"319":{"id":"/en/docs/Hydro/FAQ/upgrade-12","page_id":"/en/docs/Hydro/FAQ/upgrade","tags":[],"type":"text","url":"/en/docs/Hydro/FAQ/upgrade#recommended-upgrade-path","content":"Always upgrade the system before adding or updating plugins to avoid compatibility issues."},"320":{"id":"/en/docs/Hydro/FAQ/upgrade-13","page_id":"/en/docs/Hydro/FAQ/upgrade","tags":[],"type":"text","url":"/en/docs/Hydro/FAQ/upgrade#recommended-upgrade-path","content":"If you have installed plugins from URLs (e.g., hydrooj install https://...), re-run those install commands after a system upgrade to ensure the plugins are also updated."},"321":{"id":"/en/docs/Hydro/FAQ/upgrade-14","page_id":"/en/docs/Hydro/FAQ/upgrade","tags":[],"type":"text","url":"/en/docs/Hydro/FAQ/upgrade#recommended-upgrade-path","content":"All historical versions of Hydro ar