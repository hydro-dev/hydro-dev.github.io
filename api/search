pe":"page","content":"Database Backup and Restore","breadcrumbs":["Docs","Hydro","System Documentation"],"tags":[],"url":"/en/docs/Hydro/system/database"},"1018":{"id":"/en/docs/Hydro/system/database-0","page_id":"/en/docs/Hydro/system/database","type":"heading","tags":[],"url":"/en/docs/Hydro/system/database#overview","content":"Overview"},"1019":{"id":"/en/docs/Hydro/system/database-1","page_id":"/en/docs/Hydro/system/database","type":"heading","tags":[],"url":"/en/docs/Hydro/system/database#direct-database-access-warning","content":"Direct Database Access Warning"},"1020":{"id":"/en/docs/Hydro/system/database-2","page_id":"/en/docs/Hydro/system/database","type":"heading","tags":[],"url":"/en/docs/Hydro/system/database#backup-and-restore","content":"Backup and Restore"},"1021":{"id":"/en/docs/Hydro/system/database-3","page_id":"/en/docs/Hydro/system/database","type":"heading","tags":[],"url":"/en/docs/Hydro/system/database#automated-backups","content":"Automated Backups"},"1022":{"id":"/en/docs/Hydro/system/database-4","page_id":"/en/docs/Hydro/system/database","type":"heading","tags":[],"url":"/en/docs/Hydro/system/database#incremental-backups-hydro-500","content":"Incremental Backups (Hydro 5.0.0+)"},"1023":{"id":"/en/docs/Hydro/system/database-5","page_id":"/en/docs/Hydro/system/database","type":"heading","tags":[],"url":"/en/docs/Hydro/system/database#manual-backups","content":"Manual Backups"},"1024":{"id":"/en/docs/Hydro/system/database-6","page_id":"/en/docs/Hydro/system/database","type":"heading","tags":[],"url":"/en/docs/Hydro/system/database#manual-restore","content":"Manual Restore"},"1025":{"id":"/en/docs/Hydro/system/database-7","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#overview","content":"Hydro uses MongoDB as its primary data store."},"1026":{"id":"/en/docs/Hydro/system/database-8","page_id":"/en/docs/Hydro/system/database","tags":[],"type":"text","url":"/en/docs/Hydro/system/database#o