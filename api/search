ay-0-preparation","content":"Optional:"},"181":{"id":"/en/docs/Tools-38","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day-0-preparation","content":"Install grafana and netdata to monitor server runtime status and show leadership;"},"182":{"id":"/en/docs/Tools-39","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day-1-warm-up-contest","content":"Warm-up contests usually use at least one problem that can be brute-forced with repeated submissions, guiding contestants to submit heavily and testing server load."},"183":{"id":"/en/docs/Tools-40","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day-2-official-contest","content":"If balloons are needed, inflate them early (usually the balloon group is very busy in the hour before the contest)"},"184":{"id":"/en/docs/Tools-41","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day-2-official-contest","content":"Remember to refill printer paper, same for receipt printers."},"185":{"id":"/en/docs/Tools-42","page_id":"/en/docs/Tools","tags":[],"type":"text","url":"/en/docs/Tools#day-2-official-contest","content":"// TODO: scoreboard freeze configuration"},"186":{"id":"/en/docs/Hydro/FAQ/debug","page_id":"/en/docs/Hydro/FAQ/debug","type":"page","content":"Debugging Guide","breadcrumbs":["Docs","Hydro","FAQ"],"tags":[],"url":"/en/docs/Hydro/FAQ/debug"},"187":{"id":"/en/docs/Hydro/FAQ/debug-0","page_id":"/en/docs/Hydro/FAQ/debug","type":"heading","tags":[],"url":"/en/docs/Hydro/FAQ/debug#process-management","content":"Process Management"},"188":{"id":"/en/docs/Hydro/FAQ/debug-1","page_id":"/en/docs/Hydro/FAQ/debug","type":"heading","tags":[],"url":"/en/docs/Hydro/FAQ/debug#troubleshooting-process-failures","content":"Troubleshooting Process Failures"},"189":{"id":"/en/docs/Hydro/FAQ/debug-2","page_id":"/en/docs/Hydro/FAQ/debug","type":"heading","tags":[],"url":"/en/docs/Hydro/FAQ/debug#debugging-hydrooj","content":"Debugging HydroOJ"}