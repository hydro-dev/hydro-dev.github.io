it, run it as root.\nYou can manage it with pm2."},"769":{"id":"/en/docs/Hydro/plugins/hydrojudge-23","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-an-add-on","content":"Because a judge installed as an add-on must be on the same server as Hydro, each Hydro instance can have at most one add-on-installed judge machine."},"770":{"id":"/en/docs/Hydro/plugins/hydrojudge-24","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-an-add-on","content":"Run the following commands on the machine where Hydro is installed to install @hydrooj/hydrojudge:"},"771":{"id":"/en/docs/Hydro/plugins/hydrojudge-25","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-an-add-on","content":"After restarting Hydro, hydrojudge will run normally."},"772":{"id":"/en/docs/Hydro/plugins/hydrojudge-26","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-a-standalone-process","content":"This method helps you deploy judge machines on any server."},"773":{"id":"/en/docs/Hydro/plugins/hydrojudge-27","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-a-standalone-process","content":"type: warn"},"774":{"id":"/en/docs/Hydro/plugins/hydrojudge-28","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-a-standalone-process","content":"We recommend that all standalone judge machines use identical hardware and that you disable the built-in judge to ensure stable judging results.\nJudge-related options in System Settings only control the built-in judge. Standalone judges must be configured in judge.yaml."},"775":{"id":"/en/docs/Hydro/plugins/hydrojudge-29","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-a-standalone-process","content":"First, create an account with PRIV_JUDGE permission. See here for details. (Run this on the Hydro server)"},"776":{"id":"/en/docs/Hydro/plugins/hydrojudge-30","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-a-standalone-process","content":"Then install HydroJudge on the server that runs the judge machine:"},"777":{"id":"/en/docs/Hydro/plugins/hydrojudge-31","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-a-standalone-process","content":"Create directory ~/.config/hydro, then create file judge.yaml in it. The config format is:"},"778":{"id":"/en/docs/Hydro/plugins/hydrojudge-32","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-a-standalone-process","content":"After configuration, run the command below to start it (you can manage it with pm2):"},"779":{"id":"/en/docs/Hydro/plugins/hydrojudge-33","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#update","content":"HydroJudge receives updates from time to time. You can use yarn global upgrade-interactive --latest to check for and apply updates."},"780":{"id":"/en/docs/Hydro/plugins/hydrojudge-34","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#disable","content":"As an add-on: In System Settings > Config Management, enable Disable builtin judge, then restart Hydro."},"781":{"id":"/en/docs/Hydro/plugins/hydrojudge-35","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#disable","content":"As a standalone process: Stop it according to how you started it."},"782":{"id":"/en/docs/Hydro/plugins/hydrojudge-36","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#uninstall","content":"After disabling, run the commands below."},"783":{"id":"/en/docs/Hydro/plugins/hydrojudge-37","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-an-add-on-1","content":"Modify parameters in System Settings > hydrojudge, then restart Hydro and hydrojudge."},"784":{"id":"/en/docs/Hydro/plugins/hydrojudge-38","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-a-standalone-process-1","content":"If you need to change settings such as the maximum number of test cases per problem, add the following at the end of ~/.config/hydro/judge.yaml:"},"785":{"id":"/en/docs/Hydro/plugins/hydrojudge-39","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#as-a-standalone-process-1","content":"All settings listed here can be added here."},"786":{"id":"/en/docs/Hydro/plugins/hydrojudge-40","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#modify-compiler-options--add-support-for-new-languages","content":"Modify hydrooj.langs in Control Panel > System Settings (applies to all judge machines connected to this server)\nor configure it in ~/.config/hydro/langs.yaml (applies to a single standalone judge machine, not recommended)."},"787":{"id":"/en/docs/Hydro/plugins/hydrojudge-41","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#modify-compiler-options--add-support-for-new-languages","content":"For file format, see here."},"788":{"id":"/en/docs/Hydro/plugins/hydrojudge-42","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#modify-compiler-options--add-support-for-new-languages","content":"If you added a new language, you also need to modify Language Highlight ID and Monaco language modes in Control Panel > System Settings.\nThese define syntax highlighting (based on PrismJS) and Monaco editor language mode respectively after selecting that language."},"789":{"id":"/en/docs/Hydro/plugins/hydrojudge-43","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#modify-compiler-options--add-support-for-new-languages","content":"After modification, restart Hydro and hydrojudge."},"790":{"id":"/en/docs/Hydro/plugins/hydrojudge-44","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#modify-compiler-options--add-support-for-new-languages","content":"See more in the Compilers and Languages section."},"791":{"id":"/en/docs/Hydro/plugins/hydrojudge-45","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#debug-sandbox-environment","content":"If you need to debug compilation/runtime errors in the sandbox, use hydrojudge terminal to open an interactive judge terminal. This terminal runs in an isolated sandbox identical to the judging environment."},"792":{"id":"/en/docs/Hydro/plugins/hydrojudge-46","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#clear-data-cache","content":"To clear judging data cache, use hydrojudge cache prune to remove test data unused for 30 days. To specify days, add parameter --duration=x to clear data unused for x days."},"793":{"id":"/en/docs/Hydro/plugins/hydrojudge-47","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#clear-data-cache","content":"To clear all cached data, use hydrojudge cache clean."},"794":{"id":"/en/docs/Hydro/plugins/hydrojudge-48","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#test-data-format","content":"Configure according to Test Data Format."},"795":{"id":"/en/docs/Hydro/plugins/hydrojudge-49","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#adjust-sandbox-storage-size","content":"type: warn"},"796":{"id":"/en/docs/Hydro/plugins/hydrojudge-50","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#adjust-sandbox-storage-size","content":"If you do not adjust sandbox storage size, judging with file I/O and large input/output files may cause errors."},"797":{"id":"/en/docs/Hydro/plugins/hydrojudge-51","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#adjust-sandbox-storage-size","content":"For users installed before 2022/8/12:"},"798":{"id":"/en/docs/Hydro/plugins/hydrojudge-52","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#adjust-sandbox-storage-size","content":"Run the following on the server to find the runtime directory of hydro-sandbox:"},"799":{"id":"/en/docs/Hydro/plugins/hydrojudge-53","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#adjust-sandbox-storage-size","content":"Refer to custom mount configuration in Sandbox filesystem mount documentation, save it in the runtime directory as mount.yaml.\nModify size and nr_inodes mount parameters for work dir and tmp dir to your desired values, save, then restart hydro-sandbox to apply."},"800":{"id":"/en/docs/Hydro/plugins/hydrojudge-54","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#adjust-sandbox-storage-size","content":"For users installed after 2022/8/12:"},"801":{"id":"/en/docs/Hydro/plugins/hydrojudge-55","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#adjust-sandbox-storage-size","content":"Edit /root/.hydro/mount.yaml and modify size."},"802":{"id":"/en/docs/Hydro/plugins/hydrojudge-56","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#increase-program-stack-size","content":"Instances installed after 2022/8/12 already have unlimited stack size enabled by default; no manual action needed"},"803":{"id":"/en/docs/Hydro/plugins/hydrojudge-57","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#increase-program-stack-size","content":"In many cases, the default stack size provided by the system is insufficient. You need to manually provide a larger stack for user programs."},"804":{"id":"/en/docs/Hydro/plugins/hydrojudge-58","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#increase-program-stack-size","content":"Modify hydro-sandbox startup arguments in pm2 to ulimit -s unlimited && /usr/bin/hydro-sandbox:"},"805":{"id":"/en/docs/Hydro/plugins/hydrojudge-59","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#improve-judging-precision","content":"Disable CPU frequency scaling and Intel Turbo Boost to avoid CPU frequency fluctuations."},"806":{"id":"/en/docs/Hydro/plugins/hydrojudge-60","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#improve-judging-precision","content":"Disable ASLR so code with memory addressing errors can produce more reproducible results. Add the following line in /etc/sysctl.conf and run sudo sysctl -p:"},"807":{"id":"/en/docs/Hydro/plugins/hydrojudge-61","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#improve-judging-precision","content":"Enable sandbox CPU affinity. For example, on an 8-core system, to restrict judging tasks to CPU 2,4,6, use:"},"808":{"id":"/en/docs/Hydro/plugins/hydrojudge-62","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#improve-judging-precision","content":"Then the maximum number of concurrent tasks is the number of cores separated by , (in this example, 3), and each concurrent judging task is assigned one core in the configuration. When enabling this option, parallelism is recommended to match the number of cores available to sandbox tasks. This setting should be tuned based on the judge machine's CPU specifics (such as hyper-threading, NUMA, etc.). It also requires sandbox version v1.11.2 or above."},"809":{"id":"/en/docs/Hydro/plugins/hydrojudge-63","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#improve-judging-precision","content":"Also, to prevent other tasks from using those cores, you can use isolcpus kernel parameter. For example, on an 8-core system, to prevent other tasks from using CPU 2-7, add isolcpus=2-7 to kernel boot parameters. See Inaccurate memory measurement for how to modify kernel boot parameters."},"810":{"id":"/en/docs/Hydro/plugins/hydrojudge-64","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#inaccurate-memory-measurement","content":"If you see warning You are using cgroup v2 without kernel 5.19+. This could result in inaccurate memory usage measurements. in the control panel, it means current memory usage measurement has error."},"811":{"id":"/en/docs/Hydro/plugins/hydrojudge-65","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#inaccurate-memory-measurement","content":"Some Linux devices use cgroup2 by default, and cgroup2 kernels before 5.19 removed interfaces for precise memory usage accounting.\nFor more accurate memory measurement, enabling cgroup v1 is recommended (you can verify whether cgroup v1 is enabled by checking if /sys/fs/cgroup/memory/memory.memsw.usage_in_bytes exists):"},"812":{"id":"/en/docs/Hydro/plugins/hydrojudge-66","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#inaccurate-memory-measurement","content":"Using Ubuntu's default bootloader GRUB 2 as an example, edit /etc/default/grub:\nIn"},"813":{"id":"/en/docs/Hydro/plugins/hydrojudge-67","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#inaccurate-memory-measurement","content":"add cgroup_enable=memory swapaccount=1 systemd.unified_cgroup_hierarchy=0, so it becomes:"},"814":{"id":"/en/docs/Hydro/plugins/hydrojudge-68","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#inaccurate-memory-measurement","content":"Run the following command to update GRUB 2 config, then reboot."},"815":{"id":"/en/docs/Hydro/plugins/hydrojudge-69","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#memory-controller-not-enabled","content":"If you see warning The memory cgroup controller is not enabled. This could result in inaccurate memory usage measurements. in the control panel, it means the memory cgroup controller is not enabled on current system."},"816":{"id":"/en/docs/Hydro/plugins/hydrojudge-70","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#memory-controller-not-enabled","content":"Some Linux systems (such as Raspbian) do not enable the memory cgroup controller by default. Enabling it provides more accurate memory limits and measurements."},"817":{"id":"/en/docs/Hydro/plugins/hydrojudge-71","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#memory-controller-not-enabled","content":"Using Raspbian as an example, edit /boot/firmware/cmdline.txt (or /boot/cmdline.txt if it does not exist):\nAdd the following at the end (note the space)"},"818":{"id":"/en/docs/Hydro/plugins/hydrojudge-72","page_id":"/en/docs/Hydro/plugins/hydrojudge","tags":[],"type":"text","url":"/en/docs/Hydro/plugins/hydrojudge#memory-controller-not-enabled","content":"After reboot, check /proc/cgroups to confirm memory controller memory is enabled."},"819":{"id":"/en/docs/Hydro/plugins","page_id":"/en/docs/Hydro/plugins","type":"page","content":"Plugins","breadcrumbs":["Docs","Hydro","Plugins"],"tags":[],"url":"/en/docs/Hydro/plugins"},"820":{"id":"/en/docs/Hydro/plugins-0","page_id":"/en/docs/Hydro/plugins","type":"heading","tags":[],"url":"/en/docs/Hydro/plugins#add-on-list","content":"Add-on List"},"821":{"id":"/en/docs/Hydro/plugins-1","page_id":"/en/docs/Hydro/plugins","type":"heading","tags":[],"url":"/en/docs/Hydro/plugins#installation","content":"Installation"},"822":{"id":"/en/docs/Hydro/plugins-2","page_id":"/en/docs/Hydro/plugins","type":"heading","tags":[],"url":"/en/docs/Hydro/plugins#view-registered-plugin-list","content":"View Registered Plugin List"},"823":{"id":"/en/docs/Hydro/plugins-3","page_id":"/en/docs/Hydro/plugins","type":"heading","tags":[],"url":"/en/docs/Hydro/plugins#update","content":"Update"},"824":{"id":"/en/docs/Hydro/plugins-4","page_id":"/en/docs/Hydro/plugins","type":"heading","tags":[],"url":"/en/docs/Hydro/plugins#uninstall","content":"Uninstall"},"825":{"id":"/en/docs/Hydro/plugins-5","page_id":"/en/docs/Hydro/plugins","tags":[],"type":"text","url":"/en/docs/Hydro/plugins","content":"Hydro supports extending its functionality through plugins."},"826":{"id":"/en/docs/Hydro/plugins-6","page_id":"/en/docs/Hydro/plugins","tags":[],"type":"text","url":"/en/docs/Hydro/plugins","content":"type: warn"},"827":{"id":"/en/docs/Hydro/plugins-7","page_id":"/en/docs/Hydro/plugins","tags":[],"type":"text","url":"/en/docs/Hydro/plugins","content":"Plugins have full access to all content on your site. Do not enable plugins from unknown sources."},"828":{"id":"/en/docs/Hydro/plugins-8","page_id":"/